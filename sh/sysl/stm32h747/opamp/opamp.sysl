// Operational amplifiers

module sh.sysl.stm32h747.opamp

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x40009000

// OPAMP1 control/status register
const OPAMP1_CSR_OFFSET: u32 = 0x00000000
const OPAMP1_CSR_OPAEN_MASK: u32 = 0x00000001
const OPAMP1_CSR_OPAEN_SHIFT: u32 = 0
const OPAMP1_CSR_FORCE_VP_MASK: u32 = 0x00000002
const OPAMP1_CSR_FORCE_VP_SHIFT: u32 = 1
const OPAMP1_CSR_VP_SEL_MASK: u32 = 0x0000000c
const OPAMP1_CSR_VP_SEL_SHIFT: u32 = 2
const OPAMP1_CSR_VM_SEL_MASK: u32 = 0x00000060
const OPAMP1_CSR_VM_SEL_SHIFT: u32 = 5
const OPAMP1_CSR_OPAHSM_MASK: u32 = 0x00000100
const OPAMP1_CSR_OPAHSM_SHIFT: u32 = 8
const OPAMP1_CSR_CALON_MASK: u32 = 0x00000800
const OPAMP1_CSR_CALON_SHIFT: u32 = 11
const OPAMP1_CSR_CALSEL_MASK: u32 = 0x00003000
const OPAMP1_CSR_CALSEL_SHIFT: u32 = 12
const OPAMP1_CSR_PGA_GAIN_MASK: u32 = 0x0003c000
const OPAMP1_CSR_PGA_GAIN_SHIFT: u32 = 14
const OPAMP1_CSR_USERTRIM_MASK: u32 = 0x00040000
const OPAMP1_CSR_USERTRIM_SHIFT: u32 = 18
const OPAMP1_CSR_TSTREF_MASK: u32 = 0x20000000
const OPAMP1_CSR_TSTREF_SHIFT: u32 = 29
const OPAMP1_CSR_CALOUT_MASK: u32 = 0x40000000
const OPAMP1_CSR_CALOUT_SHIFT: u32 = 30

// OPAMP1 offset trimming register in normal mode
const OPAMP1_OTR_OFFSET: u32 = 0x00000004
const OPAMP1_OTR_TRIMOFFSETN_MASK: u32 = 0x0000001f
const OPAMP1_OTR_TRIMOFFSETN_SHIFT: u32 = 0
const OPAMP1_OTR_TRIMOFFSETP_MASK: u32 = 0x00001f00
const OPAMP1_OTR_TRIMOFFSETP_SHIFT: u32 = 8

// OPAMP1 offset trimming register in low-power mode
const OPAMP1_HSOTR_OFFSET: u32 = 0x00000008
const OPAMP1_HSOTR_TRIMLPOFFSETN_MASK: u32 = 0x0000001f
const OPAMP1_HSOTR_TRIMLPOFFSETN_SHIFT: u32 = 0
const OPAMP1_HSOTR_TRIMLPOFFSETP_MASK: u32 = 0x00001f00
const OPAMP1_HSOTR_TRIMLPOFFSETP_SHIFT: u32 = 8

// OPAMP2 control/status register
const OPAMP2_CSR_OFFSET: u32 = 0x00000010
const OPAMP2_CSR_OPAEN_MASK: u32 = 0x00000001
const OPAMP2_CSR_OPAEN_SHIFT: u32 = 0
const OPAMP2_CSR_FORCE_VP_MASK: u32 = 0x00000002
const OPAMP2_CSR_FORCE_VP_SHIFT: u32 = 1
const OPAMP2_CSR_VM_SEL_MASK: u32 = 0x00000060
const OPAMP2_CSR_VM_SEL_SHIFT: u32 = 5
const OPAMP2_CSR_OPAHSM_MASK: u32 = 0x00000100
const OPAMP2_CSR_OPAHSM_SHIFT: u32 = 8
const OPAMP2_CSR_CALON_MASK: u32 = 0x00000800
const OPAMP2_CSR_CALON_SHIFT: u32 = 11
const OPAMP2_CSR_CALSEL_MASK: u32 = 0x00003000
const OPAMP2_CSR_CALSEL_SHIFT: u32 = 12
const OPAMP2_CSR_PGA_GAIN_MASK: u32 = 0x0003c000
const OPAMP2_CSR_PGA_GAIN_SHIFT: u32 = 14
const OPAMP2_CSR_USERTRIM_MASK: u32 = 0x00040000
const OPAMP2_CSR_USERTRIM_SHIFT: u32 = 18
const OPAMP2_CSR_TSTREF_MASK: u32 = 0x20000000
const OPAMP2_CSR_TSTREF_SHIFT: u32 = 29
const OPAMP2_CSR_CALOUT_MASK: u32 = 0x40000000
const OPAMP2_CSR_CALOUT_SHIFT: u32 = 30

// OPAMP2 offset trimming register in normal mode
const OPAMP2_OTR_OFFSET: u32 = 0x00000014
const OPAMP2_OTR_TRIMOFFSETN_MASK: u32 = 0x0000001f
const OPAMP2_OTR_TRIMOFFSETN_SHIFT: u32 = 0
const OPAMP2_OTR_TRIMOFFSETP_MASK: u32 = 0x00001f00
const OPAMP2_OTR_TRIMOFFSETP_SHIFT: u32 = 8

// OPAMP2 offset trimming register in low-power mode
const OPAMP2_HSOTR_OFFSET: u32 = 0x00000018
