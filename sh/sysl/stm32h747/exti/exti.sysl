// External interrupt/event controller
//
// Corrected by patches/stm32h747.patch.hocon
// (sha256 0c8c04f1a7f1838bd293ad6c59ec47877ac4721583bc053f25f8bfb584a0f4e8):
// - RM0399 EXTI register map: EXTI_C2IMR1, C2EMR1, C2PR1 … C2PR3 at 0xC0–0xE8, laid out as CPU1's
//   at 0x80–0xA8; stm32h747xx.h EXTI_TypeDef has C2IMR1 at 0xC0 … C2PR3 at 0xE8
// - RM0399 names the block at 0x80 EXTI_C1IMR1 … EXTI_C1PR3 (CPU1's), beside CPU2's EXTI_C2… at
//   0xC0

module sh.sysl.stm32h747.exti

