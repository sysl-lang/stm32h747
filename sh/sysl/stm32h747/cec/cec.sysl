// CEC

module sh.sysl.stm32h747.cec

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x40006c00

// CEC control register
const CR_OFFSET: u32 = 0x00000000
const CR_CECEN_MASK: u32 = 0x00000001
const CR_CECEN_SHIFT: u32 = 0
const CR_TXSOM_MASK: u32 = 0x00000002
const CR_TXSOM_SHIFT: u32 = 1
const CR_TXEOM_MASK: u32 = 0x00000004
const CR_TXEOM_SHIFT: u32 = 2

// This register is used to configure the HDMI-CEC controller. It is mandatory to write CEC_CFGR
// only when CECEN=0.
const CFGR_OFFSET: u32 = 0x00000004
const CFGR_SFT_MASK: u32 = 0x00000007
const CFGR_SFT_SHIFT: u32 = 0
const CFGR_RXTOL_MASK: u32 = 0x00000008
const CFGR_RXTOL_SHIFT: u32 = 3
const CFGR_BRESTP_MASK: u32 = 0x00000010
const CFGR_BRESTP_SHIFT: u32 = 4
const CFGR_BREGEN_MASK: u32 = 0x00000020
const CFGR_BREGEN_SHIFT: u32 = 5
const CFGR_LBPEGEN_MASK: u32 = 0x00000040
const CFGR_LBPEGEN_SHIFT: u32 = 6
const CFGR_BRDNOGEN_MASK: u32 = 0x00000080
const CFGR_BRDNOGEN_SHIFT: u32 = 7
const CFGR_SFTOPT_MASK: u32 = 0x00000100
const CFGR_SFTOPT_SHIFT: u32 = 8
const CFGR_OAR_MASK: u32 = 0x7fff0000
const CFGR_OAR_SHIFT: u32 = 16
const CFGR_LSTN_MASK: u32 = 0x80000000
const CFGR_LSTN_SHIFT: u32 = 31

// CEC Tx data register
const TXDR_OFFSET: u32 = 0x00000008
const TXDR_TXD_MASK: u32 = 0x000000ff
const TXDR_TXD_SHIFT: u32 = 0

// CEC Rx Data Register
const RXDR_OFFSET: u32 = 0x0000000c
const RXDR_RXD_MASK: u32 = 0x000000ff
const RXDR_RXD_SHIFT: u32 = 0

// CEC Interrupt and Status Register
const ISR_OFFSET: u32 = 0x00000010
const ISR_RXBR_MASK: u32 = 0x00000001
const ISR_RXBR_SHIFT: u32 = 0
const ISR_RXEND_MASK: u32 = 0x00000002
const ISR_RXEND_SHIFT: u32 = 1
const ISR_RXOVR_MASK: u32 = 0x00000004
const ISR_RXOVR_SHIFT: u32 = 2
const ISR_BRE_MASK: u32 = 0x00000008
const ISR_BRE_SHIFT: u32 = 3
const ISR_SBPE_MASK: u32 = 0x00000010
const ISR_SBPE_SHIFT: u32 = 4
const ISR_LBPE_MASK: u32 = 0x00000020
const ISR_LBPE_SHIFT: u32 = 5
const ISR_RXACKE_MASK: u32 = 0x00000040
const ISR_RXACKE_SHIFT: u32 = 6
const ISR_ARBLST_MASK: u32 = 0x00000080
const ISR_ARBLST_SHIFT: u32 = 7
const ISR_TXBR_MASK: u32 = 0x00000100
const ISR_TXBR_SHIFT: u32 = 8
const ISR_TXEND_MASK: u32 = 0x00000200
const ISR_TXEND_SHIFT: u32 = 9
const ISR_TXUDR_MASK: u32 = 0x00000400
const ISR_TXUDR_SHIFT: u32 = 10
const ISR_TXERR_MASK: u32 = 0x00000800
const ISR_TXERR_SHIFT: u32 = 11
const ISR_TXACKE_MASK: u32 = 0x00001000
const ISR_TXACKE_SHIFT: u32 = 12

// CEC interrupt enable register
const IER_OFFSET: u32 = 0x00000014
const IER_RXBRIE_MASK: u32 = 0x00000001
const IER_RXBRIE_SHIFT: u32 = 0
const IER_RXENDIE_MASK: u32 = 0x00000002
const IER_RXENDIE_SHIFT: u32 = 1
const IER_RXOVRIE_MASK: u32 = 0x00000004
const IER_RXOVRIE_SHIFT: u32 = 2
const IER_BREIE_MASK: u32 = 0x00000008
const IER_BREIE_SHIFT: u32 = 3
const IER_SBPEIE_MASK: u32 = 0x00000010
const IER_SBPEIE_SHIFT: u32 = 4
const IER_LBPEIE_MASK: u32 = 0x00000020
const IER_LBPEIE_SHIFT: u32 = 5
const IER_RXACKIE_MASK: u32 = 0x00000040
const IER_RXACKIE_SHIFT: u32 = 6
const IER_ARBLSTIE_MASK: u32 = 0x00000080
const IER_ARBLSTIE_SHIFT: u32 = 7
const IER_TXBRIE_MASK: u32 = 0x00000100
const IER_TXBRIE_SHIFT: u32 = 8
const IER_TXENDIE_MASK: u32 = 0x00000200
const IER_TXENDIE_SHIFT: u32 = 9
const IER_TXUDRIE_MASK: u32 = 0x00000400
const IER_TXUDRIE_SHIFT: u32 = 10
const IER_TXERRIE_MASK: u32 = 0x00000800
const IER_TXERRIE_SHIFT: u32 = 11
const IER_TXACKIE_MASK: u32 = 0x00001000
const IER_TXACKIE_SHIFT: u32 = 12
