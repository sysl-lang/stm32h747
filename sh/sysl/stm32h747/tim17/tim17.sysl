// TIM17 input selection register
const TIM17_TISEL_OFFSET: u32 = 0x00000068
const TIM17_TISEL_TI1SEL_MASK: u32 = 0x0000000f
const TIM17_TISEL_TI1SEL_SHIFT: u32 = 0
