const CCMR1_Output_OC1M_3_SHIFT: u32 = 16

// capture/compare mode register 1 (input mode)
// The SVD declares this an alternate reading of CCMR1_Output.
const CCMR1_Input_OFFSET: u32 = 0x00000018
const CCMR1_Input_IC1F_MASK: u32 = 0x000000f0
const CCMR1_Input_IC1F_SHIFT: u32 = 4
