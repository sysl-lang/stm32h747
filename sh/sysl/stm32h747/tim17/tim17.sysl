// capture/compare register 1
const CCR1_OFFSET: u32 = 0x00000034
const CCR1_CCR1_MASK: u32 = 0x0000ffff
const CCR1_CCR1_SHIFT: u32 = 0

// break and dead-time register
const BDTR_OFFSET: u32 = 0x00000044
const BDTR_DTG_MASK: u32 = 0x000000ff
const BDTR_DTG_SHIFT: u32 = 0
const BDTR_LOCK_MASK: u32 = 0x00000300
