const EGR_CC1G_SHIFT: u32 = 1
const EGR_UG_MASK: u32 = 0x00000001
const EGR_UG_SHIFT: u32 = 0

// capture/compare mode register (output mode)
const CCMR1_Output_OFFSET: u32 = 0x00000018
const CCMR1_Output_CC1S_MASK: u32 = 0x00000003
const CCMR1_Output_CC1S_SHIFT: u32 = 0
