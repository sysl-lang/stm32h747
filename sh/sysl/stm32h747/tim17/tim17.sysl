// TIM17 alternate function register 1
const TIM17_AF1_OFFSET: u32 = 0x00000060
const TIM17_AF1_BKINE_MASK: u32 = 0x00000001
const TIM17_AF1_BKINE_SHIFT: u32 = 0
const TIM17_AF1_BKCMP1E_MASK: u32 = 0x00000002
