const DIER_BIE_SHIFT: u32 = 7
const DIER_UDE_MASK: u32 = 0x00000100
const DIER_UDE_SHIFT: u32 = 8
const DIER_CC1DE_MASK: u32 = 0x00000200
const DIER_CC1DE_SHIFT: u32 = 9
const DIER_COMDE_MASK: u32 = 0x00002000
const DIER_COMDE_SHIFT: u32 = 13

// status register
