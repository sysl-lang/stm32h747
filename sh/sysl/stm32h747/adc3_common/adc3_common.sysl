// ADC common control register
const CCR_OFFSET: u32 = 0x00000008
const CCR_DUAL_MASK: u32 = 0x0000001f
const CCR_DUAL_SHIFT: u32 = 0
const CCR_DELAY_MASK: u32 = 0x00000f00
const CCR_DELAY_SHIFT: u32 = 8
