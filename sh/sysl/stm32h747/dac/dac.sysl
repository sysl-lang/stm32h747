const DHR8R1_DACC1DHR_MASK: u32 = 0x000000ff
const DHR8R1_DACC1DHR_SHIFT: u32 = 0

// DAC channel2 12-bit right aligned data holding register
const DHR12R2_OFFSET: u32 = 0x00000014
const DHR12R2_DACC2DHR_MASK: u32 = 0x00000fff
const DHR12R2_DACC2DHR_SHIFT: u32 = 0

