const CR_MAMP1_SHIFT: u32 = 8
const CR_DMAEN1_MASK: u32 = 0x00001000
const CR_DMAEN1_SHIFT: u32 = 12
const CR_DMAUDRIE1_MASK: u32 = 0x00002000
const CR_DMAUDRIE1_SHIFT: u32 = 13
const CR_CEN1_MASK: u32 = 0x00004000
const CR_CEN1_SHIFT: u32 = 14
const CR_EN2_MASK: u32 = 0x00010000
const CR_EN2_SHIFT: u32 = 16
const CR_TEN2_MASK: u32 = 0x00020000
