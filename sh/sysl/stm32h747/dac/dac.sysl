const CR_DMAUDRIE2_SHIFT: u32 = 29
const CR_CEN2_MASK: u32 = 0x40000000
const CR_CEN2_SHIFT: u32 = 30

// DAC software trigger register
const SWTRGR_OFFSET: u32 = 0x00000004
const SWTRGR_SWTRIG1_MASK: u32 = 0x00000001
const SWTRGR_SWTRIG1_SHIFT: u32 = 0
const SWTRGR_SWTRIG2_MASK: u32 = 0x00000002
const SWTRGR_SWTRIG2_SHIFT: u32 = 1

// DAC channel1 12-bit right-aligned data holding register
const DHR12R1_OFFSET: u32 = 0x00000008
const DHR12R1_DACC1DHR_MASK: u32 = 0x00000fff
const DHR12R1_DACC1DHR_SHIFT: u32 = 0

