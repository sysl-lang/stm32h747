const DHR12LD_DACC2DHR_SHIFT: u32 = 20

// DUAL DAC 8-bit right aligned data holding register
const DHR8RD_OFFSET: u32 = 0x00000028
const DHR8RD_DACC1DHR_MASK: u32 = 0x000000ff
const DHR8RD_DACC1DHR_SHIFT: u32 = 0
