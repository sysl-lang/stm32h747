const DHR12L2_OFFSET: u32 = 0x00000018
const DHR12L2_DACC2DHR_MASK: u32 = 0x0000fff0
const DHR12L2_DACC2DHR_SHIFT: u32 = 4

// DAC channel2 8-bit right-aligned data holding register
const DHR8R2_OFFSET: u32 = 0x0000001c
const DHR8R2_DACC2DHR_MASK: u32 = 0x000000ff
const DHR8R2_DACC2DHR_SHIFT: u32 = 0

// Dual DAC 12-bit right-aligned data holding register
const DHR12RD_OFFSET: u32 = 0x00000020
const DHR12RD_DACC1DHR_MASK: u32 = 0x00000fff
const DHR12RD_DACC1DHR_SHIFT: u32 = 0
const DHR12RD_DACC2DHR_MASK: u32 = 0x0fff0000
const DHR12RD_DACC2DHR_SHIFT: u32 = 16

// DUAL DAC 12-bit left aligned data holding register
const DHR12LD_OFFSET: u32 = 0x00000024
