// Low power timer

module sh.sysl.stm32h747.lptim1

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x40002400

// Interrupt and Status Register
const ISR_OFFSET: u32 = 0x00000000
const ISR_DOWN_MASK: u32 = 0x00000040
const ISR_DOWN_SHIFT: u32 = 6
const ISR_UP_MASK: u32 = 0x00000020
const ISR_UP_SHIFT: u32 = 5
const ISR_ARROK_MASK: u32 = 0x00000010
const ISR_ARROK_SHIFT: u32 = 4
const ISR_CMPOK_MASK: u32 = 0x00000008
const ISR_CMPOK_SHIFT: u32 = 3
const ISR_EXTTRIG_MASK: u32 = 0x00000004
const ISR_EXTTRIG_SHIFT: u32 = 2
const ISR_ARRM_MASK: u32 = 0x00000002
const ISR_ARRM_SHIFT: u32 = 1
const ISR_CMPM_MASK: u32 = 0x00000001
const ISR_CMPM_SHIFT: u32 = 0

// Interrupt Clear Register
const ICR_OFFSET: u32 = 0x00000004
const ICR_DOWNCF_MASK: u32 = 0x00000040
const ICR_DOWNCF_SHIFT: u32 = 6
const ICR_UPCF_MASK: u32 = 0x00000020
const ICR_UPCF_SHIFT: u32 = 5
const ICR_ARROKCF_MASK: u32 = 0x00000010
const ICR_ARROKCF_SHIFT: u32 = 4
const ICR_CMPOKCF_MASK: u32 = 0x00000008
const ICR_CMPOKCF_SHIFT: u32 = 3
const ICR_EXTTRIGCF_MASK: u32 = 0x00000004
const ICR_EXTTRIGCF_SHIFT: u32 = 2
const ICR_ARRMCF_MASK: u32 = 0x00000002
const ICR_ARRMCF_SHIFT: u32 = 1
const ICR_CMPMCF_MASK: u32 = 0x00000001
const ICR_CMPMCF_SHIFT: u32 = 0

// Interrupt Enable Register
const IER_OFFSET: u32 = 0x00000008
const IER_DOWNIE_MASK: u32 = 0x00000040
const IER_DOWNIE_SHIFT: u32 = 6
const IER_UPIE_MASK: u32 = 0x00000020
const IER_UPIE_SHIFT: u32 = 5
const IER_ARROKIE_MASK: u32 = 0x00000010
const IER_ARROKIE_SHIFT: u32 = 4
const IER_CMPOKIE_MASK: u32 = 0x00000008
const IER_CMPOKIE_SHIFT: u32 = 3
const IER_EXTTRIGIE_MASK: u32 = 0x00000004
const IER_EXTTRIGIE_SHIFT: u32 = 2
const IER_ARRMIE_MASK: u32 = 0x00000002
const IER_ARRMIE_SHIFT: u32 = 1
const IER_CMPMIE_MASK: u32 = 0x00000001
const IER_CMPMIE_SHIFT: u32 = 0

// Configuration Register
const CFGR_OFFSET: u32 = 0x0000000c
const CFGR_ENC_MASK: u32 = 0x01000000
const CFGR_ENC_SHIFT: u32 = 24
const CFGR_COUNTMODE_MASK: u32 = 0x00800000
const CFGR_COUNTMODE_SHIFT: u32 = 23
const CFGR_PRELOAD_MASK: u32 = 0x00400000
const CFGR_PRELOAD_SHIFT: u32 = 22
const CFGR_WAVPOL_MASK: u32 = 0x00200000
const CFGR_WAVPOL_SHIFT: u32 = 21
const CFGR_WAVE_MASK: u32 = 0x00100000
const CFGR_WAVE_SHIFT: u32 = 20
const CFGR_TIMOUT_MASK: u32 = 0x00080000
const CFGR_TIMOUT_SHIFT: u32 = 19
const CFGR_TRIGEN_MASK: u32 = 0x00060000
const CFGR_TRIGEN_SHIFT: u32 = 17
const CFGR_TRIGSEL_MASK: u32 = 0x0000e000
const CFGR_TRIGSEL_SHIFT: u32 = 13
const CFGR_PRESC_MASK: u32 = 0x00000e00
const CFGR_PRESC_SHIFT: u32 = 9
const CFGR_TRGFLT_MASK: u32 = 0x000000c0
const CFGR_TRGFLT_SHIFT: u32 = 6
const CFGR_CKFLT_MASK: u32 = 0x00000018
const CFGR_CKFLT_SHIFT: u32 = 3
const CFGR_CKPOL_MASK: u32 = 0x00000006
const CFGR_CKPOL_SHIFT: u32 = 1
const CFGR_CKSEL_MASK: u32 = 0x00000001
const CFGR_CKSEL_SHIFT: u32 = 0

// Control Register
const CR_OFFSET: u32 = 0x00000010
const CR_ENABLE_MASK: u32 = 0x00000001
const CR_ENABLE_SHIFT: u32 = 0
const CR_SNGSTRT_MASK: u32 = 0x00000002
const CR_SNGSTRT_SHIFT: u32 = 1
const CR_CNTSTRT_MASK: u32 = 0x00000004
const CR_CNTSTRT_SHIFT: u32 = 2
const CR_COUNTRST_MASK: u32 = 0x00000008
const CR_COUNTRST_SHIFT: u32 = 3
const CR_RSTARE_MASK: u32 = 0x00000010
const CR_RSTARE_SHIFT: u32 = 4

// Compare Register
const CMP_OFFSET: u32 = 0x00000014
const CMP_CMP_MASK: u32 = 0x0000ffff
const CMP_CMP_SHIFT: u32 = 0

// Autoreload Register
const ARR_OFFSET: u32 = 0x00000018
const ARR_ARR_MASK: u32 = 0x0000ffff
const ARR_ARR_SHIFT: u32 = 0

// Counter Register
const CNT_OFFSET: u32 = 0x0000001c
const CNT_CNT_MASK: u32 = 0x0000ffff
const CNT_CNT_SHIFT: u32 = 0

// LPTIM configuration register 2
const CFGR2_OFFSET: u32 = 0x00000024
const CFGR2_IN1SEL_MASK: u32 = 0x00000003
const CFGR2_IN1SEL_SHIFT: u32 = 0
const CFGR2_IN2SEL_MASK: u32 = 0x00000030
const CFGR2_IN2SEL_SHIFT: u32 = 4
