// This register is used to lock the configuration of the port bits when a correct write sequence
// is applied to bit 16 (LCKK). The value of bits [15:0] is used to lock the configuration of the
// GPIO. During the write sequence, the value of LCKR[15:0] must not change. When the LOCK sequence
// has been applied on a port bit, the value of this port bit can no longer be modified until the
// next MCU reset or peripheral reset.A specific write sequence is used to write to the GPIOx_LCKR
// register. Only word access (32-bit long) is allowed during this locking sequence.Each lock bit
// freezes a specific configuration register (control and alternate function registers).
const LCKR_OFFSET: u32 = 0x0000001c
const LCKR_LCK0_MASK: u32 = 0x00000001
const LCKR_LCK0_SHIFT: u32 = 0
const LCKR_LCK1_MASK: u32 = 0x00000002
const LCKR_LCK1_SHIFT: u32 = 1
const LCKR_LCK2_MASK: u32 = 0x00000004
const LCKR_LCK2_SHIFT: u32 = 2
const LCKR_LCK3_MASK: u32 = 0x00000008
const LCKR_LCK3_SHIFT: u32 = 3
const LCKR_LCK4_MASK: u32 = 0x00000010
const LCKR_LCK4_SHIFT: u32 = 4
const LCKR_LCK5_MASK: u32 = 0x00000020
const LCKR_LCK5_SHIFT: u32 = 5
const LCKR_LCK6_MASK: u32 = 0x00000040
const LCKR_LCK6_SHIFT: u32 = 6
const LCKR_LCK7_MASK: u32 = 0x00000080
const LCKR_LCK7_SHIFT: u32 = 7
const LCKR_LCK8_MASK: u32 = 0x00000100
const LCKR_LCK8_SHIFT: u32 = 8
const LCKR_LCK9_MASK: u32 = 0x00000200
const LCKR_LCK9_SHIFT: u32 = 9
const LCKR_LCK10_MASK: u32 = 0x00000400
const LCKR_LCK10_SHIFT: u32 = 10
const LCKR_LCK11_MASK: u32 = 0x00000800
const LCKR_LCK11_SHIFT: u32 = 11
const LCKR_LCK12_MASK: u32 = 0x00001000
const LCKR_LCK12_SHIFT: u32 = 12
const LCKR_LCK13_MASK: u32 = 0x00002000
const LCKR_LCK13_SHIFT: u32 = 13
const LCKR_LCK14_MASK: u32 = 0x00004000
const LCKR_LCK14_SHIFT: u32 = 14
const LCKR_LCK15_MASK: u32 = 0x00008000
const LCKR_LCK15_SHIFT: u32 = 15
const LCKR_LCKK_MASK: u32 = 0x00010000
const LCKR_LCKK_SHIFT: u32 = 16

