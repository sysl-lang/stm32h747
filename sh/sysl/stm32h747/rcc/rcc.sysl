// Reset and clock control
//
// Corrected by patches/stm32h747.patch.hocon
// (sha256 0c8c04f1a7f1838bd293ad6c59ec47877ac4721583bc053f25f8bfb584a0f4e8):
// - RM0399 RCC_APB3ENR: bit 4 DSIEN; stm32h747xx.h RCC_APB3ENR_DSIEN_Msk = 0x00000010
// - RM0399 RCC_C1_APB3ENR: bit 4 DSIEN, as RCC_APB3ENR; stm32h747xx.h uses RCC_APB3ENR_DSIEN for
//   both
// - RM0399 RCC_APB3RSTR: bit 4 DSIRST; stm32h747xx.h RCC_APB3RSTR_DSIRST_Msk = 0x00000010
// - RM0399 RCC_APB3LPENR: bit 4 DSILPEN; stm32h747xx.h RCC_APB3LPENR_DSILPEN_Msk = 0x00000010
// - RM0399 RCC_C1_APB3LPENR: bit 4 DSILPEN, as RCC_APB3LPENR; stm32h747xx.h uses
//   RCC_APB3LPENR_DSILPEN for both

