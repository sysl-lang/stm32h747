// NAND Flash control registers
const PCR_OFFSET: u32 = 0x00000080
const PCR_PWAITEN_MASK: u32 = 0x00000002
const PCR_PWAITEN_SHIFT: u32 = 1
const PCR_PBKEN_MASK: u32 = 0x00000004
const PCR_PBKEN_SHIFT: u32 = 2
