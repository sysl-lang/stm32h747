const PCR_TAR_SHIFT: u32 = 13
const PCR_ECCPS_MASK: u32 = 0x000e0000
const PCR_ECCPS_SHIFT: u32 = 17

// This register contains information about the FIFO status and interrupt. The FMC features a FIFO
// that is used when writing to memories to transfer up to 16 words of data.This is used to quickly
// write to the FIFO and free the AXI bus for transactions to peripherals other than the FMC, while
// the FMC is draining its FIFO into the memory. One of these register bits indicates the status of
// the FIFO, for ECC purposes.The ECC is calculated while the data are written to the memory. To
// read the correct ECC, the software must consequently wait until the FIFO is empty.
const SR_OFFSET: u32 = 0x00000084
const SR_IRS_MASK: u32 = 0x00000001
const SR_IRS_SHIFT: u32 = 0
const SR_ILS_MASK: u32 = 0x00000002
const SR_ILS_SHIFT: u32 = 1
const SR_IFS_MASK: u32 = 0x00000004
const SR_IFS_SHIFT: u32 = 2
const SR_IREN_MASK: u32 = 0x00000008
const SR_IREN_SHIFT: u32 = 3
const SR_ILEN_MASK: u32 = 0x00000010
const SR_ILEN_SHIFT: u32 = 4
const SR_IFEN_MASK: u32 = 0x00000020
const SR_IFEN_SHIFT: u32 = 5
const SR_FEMPT_MASK: u32 = 0x00000040
const SR_FEMPT_SHIFT: u32 = 6

// The FMC_PMEM read/write register contains the timing information for NAND Flash memory bank.
// This information is used to access either the common memory space of the NAND Flash for command,
// address write access and data read/write access.
const PMEM_OFFSET: u32 = 0x00000088
const PMEM_MEMSET_MASK: u32 = 0x000000ff
const PMEM_MEMSET_SHIFT: u32 = 0
const PMEM_MEMWAIT_MASK: u32 = 0x0000ff00
const PMEM_MEMWAIT_SHIFT: u32 = 8
const PMEM_MEMHOLD_MASK: u32 = 0x00ff0000
const PMEM_MEMHOLD_SHIFT: u32 = 16
const PMEM_MEMHIZ_MASK: u32 = 0xff000000
const PMEM_MEMHIZ_SHIFT: u32 = 24

// The FMC_PATT read/write register contains the timing information for NAND Flash memory bank. It
// is used for 8-bit accesses to the attribute memory space of the NAND Flash for the last address
// write access if the timing must differ from that of previous accesses (for Ready/Busy
// management, refer to Section20.8.5: NAND Flash prewait feature).
const PATT_OFFSET: u32 = 0x0000008c
const PATT_ATTSET_MASK: u32 = 0x000000ff
const PATT_ATTSET_SHIFT: u32 = 0
const PATT_ATTWAIT_MASK: u32 = 0x0000ff00
const PATT_ATTWAIT_SHIFT: u32 = 8
const PATT_ATTHOLD_MASK: u32 = 0x00ff0000
const PATT_ATTHOLD_SHIFT: u32 = 16
const PATT_ATTHIZ_MASK: u32 = 0xff000000
const PATT_ATTHIZ_SHIFT: u32 = 24

// This register contain the current error correction code value computed by the ECC computation
// modules of the FMC NAND controller. When the CPU reads/writes the data from a NAND Flash memory
// page at the correct address (refer to Section20.8.6: Computation of the error correction code
// (ECC) in NAND Flash memory), the data read/written from/to the NAND Flash memory are processed
// automatically by the ECC computation module. When X bytes have been read (according to the ECCPS
// field in the FMC_PCR registers), the CPU must read the computed ECC value from the FMC_ECC
// registers. It then verifies if these computed parity data are the same as the parity value
// recorded in the spare area, to determine whether a page is valid, and, to correct it otherwise.
// The FMC_ECCR register should be cleared after being read by setting the ECCEN bit to 0. To
// compute a new data block, the ECCEN bit must be set to 1.
const ECCR_OFFSET: u32 = 0x00000094
const ECCR_ECC_MASK: u32 = 0xffffffff
const ECCR_ECC_SHIFT: u32 = 0

