// This register contains the command issued when the SDRAM device is accessed. This register is
// used to initialize the SDRAM device, and to activate the Self-refresh and the Power-down modes.
// As soon as the MODE field is written, the command will be issued only to one or to both SDRAM
// banks according to CTB1 and CTB2 command bits. This register is the same for both SDRAM banks.
const SDCMR_OFFSET: u32 = 0x00000150
const SDCMR_MODE_MASK: u32 = 0x00000007
const SDCMR_MODE_SHIFT: u32 = 0
const SDCMR_CTB2_MASK: u32 = 0x00000008
const SDCMR_CTB2_SHIFT: u32 = 3
const SDCMR_CTB1_MASK: u32 = 0x00000010
const SDCMR_CTB1_SHIFT: u32 = 4
const SDCMR_NRFS_MASK: u32 = 0x000001e0
const SDCMR_NRFS_SHIFT: u32 = 5
const SDCMR_MRD_MASK: u32 = 0x007ffe00
const SDCMR_MRD_SHIFT: u32 = 9

// This register sets the refresh rate in number of SDCLK clock cycles between the refresh cycles
// by configuring the Refresh Timer Count value.Examplewhere 64 ms is the SDRAM refresh period.The
// refresh rate must be increased by 20 SDRAM clock cycles (as in the above example) to obtain a
// safe margin if an internal refresh request occurs when a read request has been accepted. It
// corresponds to a COUNT value of 0000111000000 (448). This 13-bit field is loaded into a timer
// which is decremented using the SDRAM clock. This timer generates a refresh pulse when zero is
// reached. The COUNT value must be set at least to 41 SDRAM clock cycles.As soon as the FMC_SDRTR
// register is programmed, the timer starts counting. If the value programmed in the register is 0,
// no refresh is carried out. This register must not be reprogrammed after the initialization
// procedure to avoid modifying the refresh rate.Each time a refresh pulse is generated, this
// 13-bit COUNT field is reloaded into the counter.If a memory access is in progress, the
// Auto-refresh request is delayed. However, if the memory access and Auto-refresh requests are
// generated simultaneously, the Auto-refresh takes precedence. If the memory access occurs during
// a refresh operation, the request is buffered to be processed when the refresh is complete.This
// register is common to SDRAM bank 1 and bank 2.
const SDRTR_OFFSET: u32 = 0x00000154
const SDRTR_CRE_MASK: u32 = 0x00000001
const SDRTR_CRE_SHIFT: u32 = 0
const SDRTR_COUNT_MASK: u32 = 0x00003ffe
const SDRTR_COUNT_SHIFT: u32 = 1
const SDRTR_REIE_MASK: u32 = 0x00004000
const SDRTR_REIE_SHIFT: u32 = 14

// SDRAM Status register
const SDSR_OFFSET: u32 = 0x00000158
const SDSR_RE_MASK: u32 = 0x00000001
const SDSR_RE_SHIFT: u32 = 0
const SDSR_MODES1_MASK: u32 = 0x00000006
const SDSR_MODES1_SHIFT: u32 = 1
const SDSR_MODES2_MASK: u32 = 0x00000018
const SDSR_MODES2_SHIFT: u32 = 3
