// COMP1

module sh.sysl.stm32h747.comp1

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x58003800

// Comparator status register
const SR_OFFSET: u32 = 0x00000000
const SR_C1VAL_MASK: u32 = 0x00000001
const SR_C1VAL_SHIFT: u32 = 0
const SR_C2VAL_MASK: u32 = 0x00000002
const SR_C2VAL_SHIFT: u32 = 1
const SR_C1IF_MASK: u32 = 0x00010000
const SR_C1IF_SHIFT: u32 = 16
const SR_C2IF_MASK: u32 = 0x00020000
const SR_C2IF_SHIFT: u32 = 17

// Comparator interrupt clear flag register
const ICFR_OFFSET: u32 = 0x00000004
const ICFR_CC1IF_MASK: u32 = 0x00010000
const ICFR_CC1IF_SHIFT: u32 = 16
const ICFR_CC2IF_MASK: u32 = 0x00020000
const ICFR_CC2IF_SHIFT: u32 = 17

// Comparator option register
const OR_OFFSET: u32 = 0x00000008
const OR_AFOP_MASK: u32 = 0x000007ff
const OR_AFOP_SHIFT: u32 = 0
const OR_OR_MASK: u32 = 0xfffff800
const OR_OR_SHIFT: u32 = 11

// Comparator configuration register 1
const CFGR1_OFFSET: u32 = 0x0000000c
const CFGR1_EN_MASK: u32 = 0x00000001
const CFGR1_EN_SHIFT: u32 = 0
const CFGR1_BRGEN_MASK: u32 = 0x00000002
const CFGR1_BRGEN_SHIFT: u32 = 1
const CFGR1_SCALEN_MASK: u32 = 0x00000004
const CFGR1_SCALEN_SHIFT: u32 = 2
const CFGR1_POLARITY_MASK: u32 = 0x00000008
const CFGR1_POLARITY_SHIFT: u32 = 3
const CFGR1_ITEN_MASK: u32 = 0x00000040
const CFGR1_ITEN_SHIFT: u32 = 6
const CFGR1_HYST_MASK: u32 = 0x00000300
const CFGR1_HYST_SHIFT: u32 = 8
const CFGR1_PWRMODE_MASK: u32 = 0x00003000
const CFGR1_PWRMODE_SHIFT: u32 = 12
const CFGR1_INMSEL_MASK: u32 = 0x00070000
const CFGR1_INMSEL_SHIFT: u32 = 16
const CFGR1_INPSEL_MASK: u32 = 0x00100000
const CFGR1_INPSEL_SHIFT: u32 = 20
const CFGR1_BLANKING_MASK: u32 = 0x0f000000
const CFGR1_BLANKING_SHIFT: u32 = 24
const CFGR1_LOCK_MASK: u32 = 0x80000000
const CFGR1_LOCK_SHIFT: u32 = 31

// Comparator configuration register 2
const CFGR2_OFFSET: u32 = 0x00000010
const CFGR2_EN_MASK: u32 = 0x00000001
const CFGR2_EN_SHIFT: u32 = 0
const CFGR2_BRGEN_MASK: u32 = 0x00000002
const CFGR2_BRGEN_SHIFT: u32 = 1
const CFGR2_SCALEN_MASK: u32 = 0x00000004
const CFGR2_SCALEN_SHIFT: u32 = 2
const CFGR2_POLARITY_MASK: u32 = 0x00000008
const CFGR2_POLARITY_SHIFT: u32 = 3
const CFGR2_WINMODE_MASK: u32 = 0x00000010
const CFGR2_WINMODE_SHIFT: u32 = 4
const CFGR2_ITEN_MASK: u32 = 0x00000040
const CFGR2_ITEN_SHIFT: u32 = 6
const CFGR2_HYST_MASK: u32 = 0x00000300
const CFGR2_HYST_SHIFT: u32 = 8
const CFGR2_PWRMODE_MASK: u32 = 0x00003000
const CFGR2_PWRMODE_SHIFT: u32 = 12
const CFGR2_INMSEL_MASK: u32 = 0x00070000
