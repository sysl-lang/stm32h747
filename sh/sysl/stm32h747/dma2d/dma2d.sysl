const ISR_CTCIF_SHIFT: u32 = 4
const ISR_CEIF_MASK: u32 = 0x00000020
const ISR_CEIF_SHIFT: u32 = 5

// DMA2D interrupt flag clear register
const IFCR_OFFSET: u32 = 0x00000008
