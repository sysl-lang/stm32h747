const CR_CTCIE_MASK: u32 = 0x00001000
const CR_CTCIE_SHIFT: u32 = 12
const CR_CEIE_MASK: u32 = 0x00002000
const CR_CEIE_SHIFT: u32 = 13
const CR_MODE_MASK: u32 = 0x00070000
const CR_MODE_SHIFT: u32 = 16

