// DMA2D
//
// Corrected by patches/stm32h747.patch.hocon
// (sha256 0c8c04f1a7f1838bd293ad6c59ec47877ac4721583bc053f25f8bfb584a0f4e8):
// - RM0399 DMA2D_CR: MODE[2:0] is bits 18:16; stm32h747xx.h DMA2D_CR_MODE_Msk = 0x00070000

module sh.sysl.stm32h747.dma2d

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x52001000

// DMA2D control register
const CR_OFFSET: u32 = 0x00000000
const CR_START_MASK: u32 = 0x00000001
const CR_START_SHIFT: u32 = 0
const CR_SUSP_MASK: u32 = 0x00000002
const CR_SUSP_SHIFT: u32 = 1
